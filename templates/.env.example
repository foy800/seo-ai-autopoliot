# ======================================================================
#  seo-agent-ru: все секреты и параметры в одном файле
#  Скопируйте в .env, впишите значения и закройте доступ: chmod 600 .env
#  Файл .env никому не отправляйте и не коммитьте (он в .gitignore).
#  Пустое значение = берётся из config.json или значение по умолчанию.
#  Строки без пробелов вокруг «=», кавычки не нужны.
# ======================================================================

# ---------- ОБЯЗАТЕЛЬНО: OpenAI (текст и обложки) ----------
OPENAI_API_KEY=
# Модели: актуальные названия смотрите в документации OpenAI
OPENAI_TEXT_MODEL=gpt-4.1
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_SIZE=1536x1024
# Свой адрес API (прокси или совместимый шлюз), если нужен
# OPENAI_BASE_URL=https://api.openai.com/v1

# ---------- ОБЯЗАТЕЛЬНО для публикации: FTP сайта ----------
FTP_HOST=
FTP_USER=
FTP_PASS=
FTP_PORT=21
# 1 = FTPS (шифрование), если хостинг поддерживает
FTP_TLS=0

# ---------- Доступ к серверу (SSH): чтобы залить скилл на сервер ----------
# Используется командой:  python3 scripts/deploy.py
# Рекомендуется вход по ключу. Пароль работает только если на вашем компьютере есть sshpass.
SSH_HOST=
SSH_USER=
SSH_PORT=22
# Путь к приватному ключу, например C:/Users/имя/.ssh/id_ed25519 или ~/.ssh/id_ed25519
SSH_KEY_PATH=
# Пароль SSH (только если нет ключа)
SSH_PASS=
# Папка на сервере, куда установить скилл
SSH_REMOTE_DIR=~/seo-agent-ru

# ======================================================================
#  Параметры. Каждый перекрывает одноимённое значение в config.json.
#  Имя = SEO_ + название параметра большими буквами.
# ======================================================================

# ---------- Сайт ----------
# Пример: https://example.ru
SEO_SITE_URL=
SEO_SITE_NAME=
SEO_REGION=
# Страница услуги для CTA выбирается автоматически из context/pages.csv
# (колонки title, description, cta). URL, телефон и данные автора вводить не нужно.

# ---------- Публикация ----------
# ftp = заливать на сайт по FTP, local = только собрать файлы в out/site
SEO_PUBLISH_MODE=ftp
# Папка сайта на FTP, пример: /example.ru/public_html
SEO_FTP_DIR=
SEO_BLOG_PATH=blog
SEO_BLOG_TITLE=Статьи
SEO_BLOG_DESCRIPTION=
# false = не перезаписывать существующий /blog/index.html
SEO_UPDATE_BLOG_INDEX=true

# ---------- Контент-план (Excel) ----------
# Файл создаётся автоматически в папке проекта
SEO_PLAN_PATH=content-plan.xlsx
# Одобрение «да» в колонке «Одобрено» обязательно всегда и отключить его нельзя.
# Сколько заголовков подбирать за запуск: 0 = ко всем ключам без заголовка
SEO_TITLES_PER_RUN=0

# ---------- Объём и качество ----------
SEO_DAILY_LIMIT=3
SEO_MIN_CHARS=2000
SEO_TARGET_CHARS=3500
SEO_MIN_INTERNAL_LINKS=2
SEO_MAX_INTERNAL_LINKS=6
SEO_MIN_KEYWORD_IN_BODY=1
SEO_MAX_KEYWORD_DENSITY_PCT=3.0
# Description: 160-200 знаков
SEO_DESCRIPTION_MIN=160
SEO_DESCRIPTION_MAX=200
# Эмодзи для Description через запятую, если нужны по ТЗ
SEO_DESCRIPTION_EMOJIS=
# Сколько раз переделывать статью, не прошедшую проверку
SEO_MAX_ATTEMPTS=3
# Вычитка от ИИ-слопа и корректура вторым проходом
SEO_HUMANIZE_PASS=true
