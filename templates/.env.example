# Скопируйте в .env, впишите ключ и закройте доступ: chmod 600 .env
# Файл .env не коммитить и никому не отправлять.
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4.1
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_SIZE=1536x1024

# Доступ по FTP к сайту (нужен при publish_mode = ftp). Пароль только здесь.
FTP_HOST=
FTP_USER=
FTP_PASS=
FTP_PORT=21
FTP_TLS=0
